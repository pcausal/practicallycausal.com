---
title: Publications - Practically Causal
styles:
	- publications.css
layout: layouts/base.liquid
---

<section class="publications">
	<h1 class="publications_title">Publications</h1>
	<div class="publications_body">
		{{ cms.basic.publications.html }}
	</div>
	<div class="publications_content">
		{% assign current_year = '' %}
		{% for paper in cms.papers reversed %}
			{% assign paper_year = paper.date | year %}
			{% if current_year != paper_year %}
				{% assign current_year = paper_year %}
				<p class="publications_year">{{ current_year }}</p>
			{% endif %}
			{% include 'includes/paper.liquid' with paper %}
		{% endfor %}
	</div>
</section>
