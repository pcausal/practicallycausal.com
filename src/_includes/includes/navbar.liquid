<nav class="navbar">
	<a class="navbar_logo" href="/">
		<img height="72" src="{{ cms.basic.logo[0].url }}">
		{{ cms.basic.shortIntro.html }}
	</a>
	<div class="navbar_header">
		{% for social in cms.socialMedias %}
			<a class="navbar_social" href="{{ social.url }}">
				<img src="{{ social.icon.url }}" />
			</a>
		{% endfor %}
		<div class="navbar_search">
			<script
				src="https://cse.google.com/cse.js?cx=c80ca2f8d0f78127b"
				async
			></script>
			<div class="gcse-search"></div>
		</div>
	</div>
	<hr class="navbar_divider" />
	{% assign navLinks = cms.website.navigationBar %}
	{% assign navOverrides = links %}
	<div class="navbar_main">
		<div class="navbar_full">
			{% for link in navLinks %}
				{% assign override = navOverrides | where: 'slug', link.slug | first %}
				{% assign displayName = override.name | default: link.name %}
				{% assign dropdownLinks = override.links | default: link.links %}
				{% assign hasDropdown = dropdownLinks and dropdownLinks.size > 0 %}
				{% assign href = override.href %}
				{% if href == nil %}
					{% assign href = '/#' | append: link.slug %}
					{% if link.slug == 'join' %}
						{% assign href = '/join/' %}
					{% elsif link.slug == 'events' %}
						{% assign href = '/events/' %}
					{% endif %}
				{% endif %}
				{% if hasDropdown %}
					<div class="navbar_dropdown">
						<a class="navbar_dropdown-trigger" href="{{ href }}">
							{{ displayName }}
							<img src="{{ cms.website.downIcon.url }}" />
						</a>
						<div class="navbar_dropdown-container">
							<div class="navbar_dropdown-content">
								{% for sublink in dropdownLinks %}
									{% assign subOverride = navOverrides | where: 'slug', sublink.slug | first %}
									{% assign subName = sublink.name %}
									{% assign subHref = sublink.href %}
									{% if subOverride and subOverride.name %}
										{% assign subName = subOverride.name %}
									{% endif %}
									{% if subOverride and subOverride.href %}
										{% assign subHref = subOverride.href %}
									{% endif %}
									{% if subHref == nil %}
										{% assign subHref = '/#' | append: sublink.slug %}
									{% endif %}
									<a
										class="navbar_dropdown-link"
										href="{{ subHref }}"
									>
										{{ subName }}
									</a>
								{% endfor %}
							</div>
						</div>
					</div>
				{% else %}
					<a
						class="navbar_link{% if link.slug == 'join' %} highlight{% endif %}"
						href="{{ href }}"
					>
						{{ displayName }}
					</a>
				{% endif %}
			{% endfor %}
		</div>
		<button class="navbar_menu-button" onclick="document.querySelector('.navbar_menu-toggle').classList.toggle('navbar_hidden')">Menu</button>
	</div>
	<div class="navbar_menu-toggle navbar_hidden">
		{% for link in navLinks %}
			{% assign override = navOverrides | where: 'slug', link.slug | first %}
			{% assign displayName = override.name | default: link.name %}
			{% assign dropdownLinks = override.links | default: link.links %}
			{% assign hasDropdown = dropdownLinks and dropdownLinks.size > 0 %}
			{% assign href = override.href %}
			{% if href == nil %}
				{% assign href = '/#' | append: link.slug %}
				{% if link.slug == 'join' %}
					{% assign href = '/join/' %}
				{% elsif link.slug == 'events' %}
					{% assign href = '/events/' %}
				{% endif %}
			{% endif %}
			{% if hasDropdown %}
				<div class="navbar_dropdown">
					<a class="navbar_dropdown-trigger" href="{{ href }}">
						{{ displayName }}
						<img src="{{ cms.website.downIcon.url }}" />
					</a>
					<div class="navbar_dropdown-container">
						<div class="navbar_dropdown-content">
							{% for sublink in dropdownLinks %}
								{% assign subOverride = navOverrides | where: 'slug', sublink.slug | first %}
								{% assign subName = sublink.name %}
								{% assign subHref = sublink.href %}
								{% if subOverride and subOverride.name %}
									{% assign subName = subOverride.name %}
								{% endif %}
								{% if subOverride and subOverride.href %}
									{% assign subHref = subOverride.href %}
								{% endif %}
								{% if subHref == nil %}
									{% assign subHref = '/#' | append: sublink.slug %}
								{% endif %}
								<a
									class="navbar_dropdown-link"
									href="{{ subHref }}"
								>
									{{ subName }}
								</a>
							{% endfor %}
						</div>
					</div>
				</div>
			{% else %}
				<a
					class="navbar_link"
					href="{{ href }}"
				>
					{{ displayName }}
				</a>
			{% endif %}
		{% endfor %}
	</div>
</nav>
