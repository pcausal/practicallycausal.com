<tr class="events_event">
	<td class="events_event-date">
		<span class="events_event-month">{{ event.date | month }}</span>
		<span class="events_event-day">{{ event.date | day }}</span>
		<span class="events_event-year">{{ event.date | year }}</span>
	</td>
	<td class="events_event-title">{{ event.title }}</td>
	<td class="events_event-hosts">
		{% if event.hosts and event.hosts.length > 0 %}
			{% include 'includes/authors.liquid', authors: event.hosts %}
		{% else %}
			—
		{% endif %}
	</td>
</tr>
