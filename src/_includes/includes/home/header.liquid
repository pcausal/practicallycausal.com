{% comment %}
<header class="home-header">
	<div class="home-header_foreground">
		<hr class="home-header_divider" />
		<div class="home-header_content">
			<h1 class="home-header_title">{{ cms.basic.name }}</h1>
			<h3 class="home-header_subtitle">{{ cms.basic.longName }}</h3>
			<p class="home-header_body">
				{{ cms.basic.shortIntro.html | squeezeTag }}
			</p>
		</div>
	</div>
</header>
{% endcomment %}
<section class="splide" aria-label="Projects carousel">
	<div class="splide__track">
		<ul class="splide__list">
			{% for project in cms.projects %}
			{% assign project_title_lower = project.title | downcase %}
			{% assign project_slug_lower = project.slug | downcase %}
			{% unless project_title_lower contains 'award' or project_slug_lower contains 'award' %}
			<li class="project splide__slide">{% if project.image %}<img
				src="{{ project.image.url }}"
				alt="{{ project.title }}"
			/>{% endif %}
			<div>
			<h3>{{ project.title }}</h3>
			{% if project.collaborators.size > 0 %}
			<p class="collaborators">
				{% for collaborator in project.collaborators %}<a{% if collaborator.homepage %} href="{{ collaborator.homepage }}"{% endif %}>{{ collaborator.name }}</a
				>{% unless forloop.last %}, {% endunless %}{% endfor %}
			</p>
			{% endif %} {% if project.description and project.description.text.size > 0 %}
			{% assign full_text = project.description.text | strip | replace: '(e.g.', '' | replace: '(e.g', '' | replace: '\n', ' ' | replace: '\r', ' ' | replace: '  ', ' ' %}
			{% assign full_text = full_text | replace: ' We offer', ' We offer' | replace: '  We offer', ' We offer' %}
			{% assign sentences = full_text | split: '.' %}
			{% assign short_description = '' %}
			{% assign sentence_count = sentences.size | minus: 1 %}
			{% for sentence in sentences limit: sentence_count %}
				{% assign sentence_stripped = sentence | strip %}
				{% assign sentence_lower = sentence_stripped | downcase %}
				{% unless sentence_lower contains 'we will pair' or sentence_lower contains 'we provide' %}
					{% if short_description.size == 0 %}
						{% assign short_description = sentence_stripped | append: '.' %}
					{% else %}
						{% assign short_description = short_description | append: ' ' | append: sentence_stripped | append: '.' %}
					{% endif %}
				{% endunless %}
			{% endfor %}
			{% if short_description.size == 0 %}
				{% assign short_description = full_text | truncate: 300 %}
			{% endif %}
			<div class="description">{{ short_description }}</div>
			{% endif %}
			<div class="project_links">
				{% if project.url %}
				<a href="{{ project.url }}" class="project_link project_link-primary" target="_blank" rel="noopener noreferrer">
					Project Website →
				</a>
				{% endif %}
				<a href="/publications/" class="project_link project_link-secondary">
					View Publications →
				</a>
			</div>
			{% if project.softwares.size > 0 or project.links.size > 0 %}
			<p class="links">
				{% if project.softwares.size > 0 %}<strong>Software</strong>: {% for
				software in project.softwares %}<a
					href="/software/#{{ software.slug }}"
					>{{ software.name }}</a
				>{% unless forloop.last and project.links.size == 0 %}, {% endunless
				%}{% endfor %}{% endif %} {% if project.links.size > 0 %}<strong
					>Link{% if project.links.size > 1 %}s{% endif %}</strong
				>: {% for link in project.links %}<a href="{{ link.url }}">{{
					link.name
				}}</a
				>{% unless forloop.last %}, {% endunless %}{% endfor %}{% endif %}
			</p>
			{% endif %}</div></li>
			{% endunless %}
			{% endfor %}
		</ul>
	</div>
</section>
<script>
	new Splide('.splide', {type: 'loop', autoplay: true, interval: 7000}).mount()
</script>
