---
title: Events - Practically Causal
styles:
  - events.css
layout: layouts/base.liquid
---

<section class="events">
	<h1 class="events_title">Activities & Events</h1>
	<div class="events_body">{{ cms.basic.events.html }}</div>
	<div class="events_content">
		{% if cms.events.size > 0 %}
		<table class="events_table">
			<thead>
				<tr>
					<th>Date</th>
					<th>Title</th>
					<th>Presenters</th>
				</tr>
			</thead>
			<tbody>
				{% for event in cms.events %}
					{% include 'includes/event.liquid' with event %}
				{% endfor %}
			</tbody>
		</table>
		{% endif %}
	</div>
</section>
